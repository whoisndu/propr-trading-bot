# Copy this file to .env and fill in your real values. .env is gitignored.

# Get this from https://app.propr.xyz/settings after purchasing a challenge.
PROPR_API_KEY=

# "beta" or "live". Start with beta.
PROPR_ENV=beta

# true = log what the bot would do using live prices, no real orders placed,
# no PROPR_API_KEY required. false = place real orders.
DRY_RUN=true
